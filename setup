#!/usr/bin/env bash
SRC_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]:-$0}")")"
BIN_DIR="$HOME/.local/bin"
RC_FILE="$HOME/.bashrc"
if [[ "$(basename "$SHELL")" == "zsh" ]]; then RC_FILE="$HOME/.zshrc"; fi

echo -e "\n⚙️  Setting up agent_vscode in-place at $SRC_DIR...\n"

mkdir -p "$SRC_DIR/tools" "$SRC_DIR/manage" "$SRC_DIR/sessions/.bindings"

chmod +x "$SRC_DIR/agent_vscode" "$SRC_DIR/setup" 2>/dev/null
chmod +x "$SRC_DIR"/tools/* 2>/dev/null
chmod +x "$SRC_DIR"/manage/* 2>/dev/null

mkdir -p "$BIN_DIR"
ln -sf "$SRC_DIR/agent_vscode" "$BIN_DIR/agent_vscode"
echo "   ✔ Global symlink established ($BIN_DIR/agent_vscode -> $SRC_DIR/agent_vscode)"

if ! grep -q "$BIN_DIR" "$RC_FILE" 2>/dev/null; then
    echo -e "\nexport PATH=\"$HOME/.local/bin:\$PATH\"" >> "$RC_FILE"
    echo "   ✔ PATH updated in $(basename "$RC_FILE")"
fi

# --- AUTOMATIC VS CODE KEYBINDING CONFIGURATION ---
echo "   ⌨️  Scanning for local VS Code installations to configure hotkey..."
KB_PATHS=(
    "$HOME/Library/Application Support/Code/User/keybindings.json"
    "$HOME/Library/Application Support/Code - Insiders/User/keybindings.json"
    "$HOME/.config/Code/User/keybindings.json"
    "$HOME/.config/Code - Insiders/User/keybindings.json"
)

# Note the escaped \n so it is parsed as a newline by VS Code terminal but is valid JSON string during parse
NEW_BINDING_JSON='{"key": "cmd+shift+enter", "command": "workbench.action.terminal.sendSequence", "args": {"text": "agent_vscode fill\n"}, "when": "editorTextFocus"}'

for kb_path in "${KB_PATHS[@]}"; do
    kb_dir=$(dirname "$kb_path")
    if [[ -d "$kb_dir" ]]; then
        echo "      ✔ Found VS Code configuration directory: $kb_dir"
        
        # Robust in-place edit using Perl (handles comments, trailing commas, and formatting safely)
        perl -MJSON::PP -e '
            my ($path, $new_bind_str) = @ARGV;
            my $new_binding = decode_json($new_bind_str);
            
            my $json_text = "[]";
            if (-f $path && -s $path) {
                open my $fh, "<", $path or die "Could not open $path: $!";
                $json_text = do { local $/; <$fh> };
                close $fh;
            }
            
            # 1. Strip C/C++ style comments safely
            $json_text =~ s/\/\/.*$//gm;
            $json_text =~ s/\/\*.*?\*\///gs;
            $json_text =~ s/^\s+//;
            $json_text =~ s/\s+$//;
            
            if ($json_text eq "") {
                $json_text = "[]";
            }
            
            my $data;
            eval {
                $data = decode_json($json_text);
            };
            if ($@) {
                # If existing is completely corrupted, fall back safely to empty array
                warn "      ⚠️  existing keybindings.json malformed ($@). Initializing safely.\n";
                $data = [];
            }
            
            if (ref($data) eq "ARRAY") {
                my $exists = 0;
                for my $item (@$data) {
                    if ($item->{command} && $item->{command} eq "workbench.action.terminal.sendSequence" && $item->{args} && $item->{args}->{text} =~ /agent_vscode fill/) {
                        $exists = 1;
                        last;
                    }
                }
                
                if (!$exists) {
                    push @$data, $new_binding;
                    my $coder = JSON::PP->new->pretty->canonical;
                    open my $fh, ">", $path or die "Could not write to $path: $!";
                    print $fh $coder->encode($data);
                    close $fh;
                    print "      ✔ Keybinding successfully added to $path!\n";
                } else {
                    print "      ✔ Hotkey '\''cmd+shift+enter'\'' already configured in $path.\n";
                }
            } else {
                warn "      ⚠️  keybindings.json root is not a JSON array. Skipping.\n";
            }
        ' "$kb_path" "$NEW_BINDING_JSON"
    fi
done

if [[ "$RC_FILE" == *".zshrc" ]]; then
    # Clean previous blocks safely
    if grep -q "command_not_found_handler" "$RC_FILE"; then
        cp "$RC_FILE" "${RC_FILE}.bak"
        perl -0777 -pe 's/# --- AGENT VSCODE COMMAND ROUTER INTEGRATION ---.*?# --- END AGENT VSCODE INTEGRATION ---//gs' "${RC_FILE}.bak" > "$RC_FILE"
        perl -i -ne 'print unless /command_not_found_handler/ || /agent suggest/ || /agent terminal/ || /agent_vscode terminal/ || /_agent_vscode_precmd/ || /_agent_vscode_accept_line/' "$RC_FILE"
    fi

    cat << 'OUT_EOF' >> "$RC_FILE"

# --- AGENT VSCODE COMMAND ROUTER INTEGRATION ---
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
    _agent_vscode_precmd() {
        local last_status=$?

        local tmp_file="$HOME/.agent_vscode/suggested_command.tmp"
        if [[ -f "$tmp_file" ]]; then
            local suggestion
            suggestion=$(cat "$tmp_file")
            rm -f "$tmp_file"
            if [[ -n "$suggestion" ]]; then
                print -z "$suggestion"
                return 0
            fi
        fi

        if [[ "$last_status" -ne 0 ]]; then
            local last_cmd
            last_cmd=$(fc -ln -1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [[ -n "$last_cmd" ]]; then
                local first_word="${last_cmd%% *}"
                local first_word_lower
                first_word_lower=$(echo "$first_word" | tr '[:upper:]' '[:lower:]')
                local suspect_words="what who where why how which is are can could should would do does did tell say ask show list please hello help ok hey hi terminal explain debug find it's its there's theres can you could you should we do you did you check analyze test write edit run awesome perfect cool excellent great wait yes no but look for okay"
                if [[ " $suspect_words " =~ " $first_word_lower " ]]; then
                    if [[ -z "$AGENT_VSCODE_SESSION_NAME" ]]; then
                        echo "ℹ️  Command failed but matched natural language pattern. Consulting general LLM..." >&2
                    fi
                    local suggestion
                    suggestion=$(agent_vscode terminal "$last_cmd")
                    if [[ "$suggestion" =~ ^COMMAND: ]]; then
                        local cmd="${suggestion#COMMAND:}"
                        if [[ -n "$cmd" ]]; then
                            print -z "$cmd"
                        fi
                    elif [[ "$suggestion" =~ ^CHAT: ]]; then
                        local response="${suggestion#CHAT:}"
                        echo -e "\n$response\n" >&2
                    fi
                fi
            fi
        fi
    }

    autoload -Uz add-zsh-hook
    add-zsh-hook precmd _agent_vscode_precmd

    _agent_vscode_accept_line() {
        local buf="${BUFFER#"${BUFFER%%[![:space:]]*}"}"
        buf="${buf%"${buf##*[![:space:]]}"}"

        if [[ -n "$buf" ]]; then
            local first_word="${buf%% *}"
            local first_word_lower
            first_word_lower=$(echo "$first_word" | tr '[:upper:]' '[:lower:]')

            # Prepend agent_vscode if first word is a recognized tool/command
            local tool_words="ask fill context plan read unread update clear help start resume stop list delete"
            if [[ " $tool_words " =~ " $first_word_lower " ]]; then
                BUFFER="agent_vscode $buf"
                zle .accept-line
                return 0
            fi

            local is_suspect=0
            local suspect_words="what who where why how which is are can could should would do does did tell say ask show list please hello help ok hey hi terminal explain debug find it's its there's theres can you could you should we do you did you check analyze test write edit run awesome perfect cool excellent great wait yes no but look for okay"
            
            local cmd_type=""
            if [[ -n "$first_word" ]]; then
                cmd_type=$(whence -w "$first_word" 2>/dev/null | awk '{print $2}')
            fi

            # 1. Force intercept if it starts with a known natural language word
            if [[ " $suspect_words " =~ " $first_word_lower " ]]; then
                is_suspect=1
            fi

            # 2. Intercept if the prompt contains a question mark or quotes, 
            # ONLY IF the first word is not a valid system command.
            if [[ "$is_suspect" -eq 0 ]]; then
                if [[ "$cmd_type" == "none" || -z "$cmd_type" ]]; then
                    if [[ ! "$first_word" =~ ^[\./~] && ! "$first_word" == *=* ]]; then
                        if [[ "$buf" == *[\?]* ]] || [[ "$buf" == *[\'\"]* ]]; then
                            is_suspect=1
                        fi
                    fi
                fi
            fi

            if [[ "$is_suspect" -eq 1 ]]; then
                print -s "$buf"
                BUFFER=""
                echo -ne "\n"
                if [[ -z "$AGENT_VSCODE_SESSION_NAME" ]]; then
                    echo "ℹ️  Consulting general LLM..." >&2
                fi
                local suggestion
                suggestion=$(agent_vscode terminal "$buf")
                if [[ "$suggestion" =~ ^COMMAND: ]]; then
                    local cmd="${suggestion#COMMAND:}"
                    if [[ -n "$cmd" ]]; then
                        BUFFER="$cmd"
                    fi
                elif [[ "$suggestion" =~ ^CHAT: ]]; then
                    local response="${suggestion#CHAT:}"
                    echo -e "\n$response\n" >&2
                fi
                zle reset-prompt
                return 0
            fi
        fi
        zle .accept-line
    }

    if [[ -o interactive ]]; then
        zle -N accept-line _agent_vscode_accept_line
    fi

    command_not_found_handler() {
        if command -v agent_vscode &>/dev/null; then
            if [[ -z "$AGENT_VSCODE_SESSION_NAME" ]]; then
                echo "ℹ️  No active agent_vscode session. Using general LLM suggestion..." >&2
            fi

            local suggestion
            suggestion=$(agent_vscode terminal "$@")

            if [[ "$suggestion" =~ ^COMMAND: ]]; then
                local cmd="${suggestion#COMMAND:}"
                if [[ -n "$cmd" ]]; then
                    mkdir -p "$HOME/.agent_vscode"
                    echo -n "$cmd" > "$HOME/.agent_vscode/suggested_command.tmp"
                    return 0
                fi
            elif [[ "$suggestion" =~ ^CHAT: ]]; then
                local response="${suggestion#CHAT:}"
                echo -e "\n$response\n" >&2
                return 0
            fi

            echo "zsh: command not found: $1" >&2
            return 127
        else
            echo "zsh: command not found: $1" >&2
            return 127
        fi
    }
fi
# --- END AGENT VSCODE INTEGRATION ---
OUT_EOF
    echo "   ✔ Command Router integration updated inside $RC_FILE."
fi

echo -e "\n✅ agent_vscode deployment complete!"
