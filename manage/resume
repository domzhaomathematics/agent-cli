#!/usr/bin/env bash
NAME="$1"
if [[ ! -d "$AGENT_VSCODE_DIR/sessions/$NAME" ]]; then echo "❌ Error: Session '$NAME' does not exist."; exit 1; fi

S_DIR="$AGENT_VSCODE_DIR/sessions/$NAME"
CURRENT_TTY=$(tty | sed 's|/|_|g')
echo "$NAME:$$" > "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"

echo "[Session: $NAME] 🔄 Resuming workspace. Dropping into monitored shell..."

export AGENT_VSCODE_SESSION_RESOLVED="1"
export AGENT_VSCODE_SESSION_NAME="$NAME"
export AGENT_VSCODE_SESSION_DIR="$S_DIR"

if [[ "$(uname)" == "Darwin" ]]; then
    script -a -F -q "$S_DIR/logs/terminal_raw.log"
else
    script -a -f -q "$S_DIR/logs/terminal_raw.log"
fi

rm -f "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"
rm -f "$S_DIR/logs/terminal_raw.log"
echo "[Global] 🛑 Session ended. Logs cleared. Terminal unbound."
