#!/usr/bin/env bash
NAME="$1"
if [[ -z "$NAME" ]]; then echo "Usage: agent_vscode start <name>"; exit 1; fi

S_DIR="$AGENT_VSCODE_DIR/sessions/$NAME"
mkdir -p "$S_DIR/logs" "$S_DIR/scripts"
> "$S_DIR/context.txt"
> "$S_DIR/logs/terminal_raw.log"

choose_option() {
    local options=("$@")
    local selected=0
    local num_opts=${#options[@]}
    
    echo -ne "\033[?25l"
    trap 'echo -ne "\033[?25h"; exit 1' SIGINT
    
    while true; do
        for i in "${!options[@]}"; do
            if [[ $i -eq $selected ]]; then 
                echo -e "\033[32m ❯ ${options[$i]}\033[0m\033[K"
            else 
                echo -e "   ${options[$i]}\033[K"
            fi
        done
        
        read -rsn1 key
        if [[ $key == $'\x1b' ]]; then
            read -rsn2 key2
            if [[ $key2 == '[A' ]]; then
                ((selected--))
                if (( selected < 0 )); then selected=$((num_opts - 1)); fi
            elif [[ $key2 == '[B' ]]; then
                ((selected++))
                if (( selected >= num_opts )); then selected=0; fi
            fi
        elif [[ -z "$key" || $key == $'\n' ]]; then
            break
        fi
        
        echo -ne "\033[${num_opts}A"
    done
    
    echo -ne "\033[?25h"
    trap - SIGINT
    return $selected
}

KEYS_FILE="$AGENT_VSCODE_DIR/keys.conf"
touch "$KEYS_FILE"

declare -a K_NAMES=()
declare -a K_VALS=()
while IFS='=' read -r k_name k_val || [[ -n "$k_name" ]]; do
    if [[ -n "$k_name" && -n "$k_val" ]]; then
        K_NAMES+=("${k_name/$'\n'/}")
        K_VALS+=("${k_val/$'\n'/}")
    fi
done < "$KEYS_FILE"

if [[ ${#K_NAMES[@]} -eq 0 ]]; then
    echo -e "\n🔑 No API keys found. Let's add one."
    read -e -p "Enter Key Name (e.g., Personal, Work): " SELECTED_KEY_NAME
    echo -n "Enter Gemini API Key: "
    read -ers SELECTED_KEY_VAL
    echo " (${#SELECTED_KEY_VAL} chars)"
    echo "$SELECTED_KEY_NAME=$SELECTED_KEY_VAL" >> "$KEYS_FILE"
else
    echo -e "\n🔑 Select an API Key for this session:"
    MENU_OPTS=("${K_NAMES[@]}" "➕ Add New Key")
    choose_option "${MENU_OPTS[@]}"
    CHOICE=$?
    
    if (( CHOICE == ${#K_NAMES[@]} )); then
        read -e -p "Enter Key Name (e.g., Personal, Work): " SELECTED_KEY_NAME
        echo -n "Enter Gemini API Key: "
        read -ers SELECTED_KEY_VAL
        echo " (${#SELECTED_KEY_VAL} chars)"
        echo "$SELECTED_KEY_NAME=$SELECTED_KEY_VAL" >> "$KEYS_FILE"
    else
        SELECTED_KEY_NAME="${K_NAMES[$CHOICE]}"
        SELECTED_KEY_VAL="${K_VALS[$CHOICE]}"
    fi
fi

echo "export GEMINI_API_KEY=\"$SELECTED_KEY_VAL\"" > "$S_DIR/api.env"
echo "export GEMINI_API_KEY_NAME=\"$SELECTED_KEY_NAME\"" >> "$S_DIR/api.env"
source "$S_DIR/api.env"
echo -e "\n[Session: $NAME] 🔑 Using API Key: $SELECTED_KEY_NAME"

CURRENT_TTY=$(tty | sed 's|/|_|g')
echo "$NAME:$$" > "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"
echo "[Session: $NAME] Workspace created. Dropping into monitored shell..."

export AGENT_VSCODE_SESSION_RESOLVED="1"
export AGENT_VSCODE_SESSION_NAME="$NAME"
export AGENT_VSCODE_SESSION_DIR="$S_DIR"

if [[ "$(uname)" == "Darwin" ]]; then
    script -F -q "$S_DIR/logs/terminal_raw.log"
else
    script -f -q "$S_DIR/logs/terminal_raw.log"
fi

rm -f "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"
rm -f "$S_DIR/logs/terminal_raw.log"
echo "[Global] Session ended. Logs cleared. Terminal unbound."
