#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] Session not active."; exit 1; fi

STATE_FILE="$HOME/.agentvscode/active_editor.json"
if [[ ! -f "$STATE_FILE" ]]; then
    echo "❌ Error: No active editor state found."
    exit 1
fi

ACTIVE_FILE=$(jq -r '.filePath // empty' "$STATE_FILE")
if [[ -z "$ACTIVE_FILE" ]]; then
    echo "❌ Error: Active file path not found in editor state."
    exit 1
fi

if [[ ! -f "$ACTIVE_FILE" ]]; then
    echo "❌ Error: Active file does not exist on disk: $ACTIVE_FILE"
    exit 1
fi

echo "🔍 [Agent Fill] Target file identified: $ACTIVE_FILE"

# Match lines starting with optional spaces/tabs then ##
INDICATORS=$(python3 -c '
import sys, re
with open(sys.argv[1], "r", encoding="utf-8") as f:
    for i, line in enumerate(f, 1):
        m = re.match(r"^([      ]*)(##\s*(.*))$", line)
        if m:
            print(f"   - Line {i}: \"{m.group(2).strip()}\"")
' "$ACTIVE_FILE" 2>/dev/null)

if [[ -z "$INDICATORS" ]]; then
    echo "ℹ️  No indicators (starting with ##) found in the active file."
    exit 0
fi

echo "$INDICATORS"

# Sync context edits
if [[ -x "$AGENT_VSCODE_DIR/tools/update" ]]; then "$AGENT_VSCODE_DIR/tools/update" -q; fi

TMP_LOGS="$AGENT_VSCODE_DIR/tmp_logs_terminal_$$.txt"
if [[ -x "$AGENT_VSCODE_DIR/tools/logs" ]]; then
    "$AGENT_VSCODE_DIR/tools/logs" 100 -q > "$TMP_LOGS" 2>/dev/null
else
    > "$TMP_LOGS"
fi

echo "🧠 Consulting Gemini (Model: $AGENT_VSCODE_MODEL)... [Thinking...]"

SYS_PROMPT="You are a precise coding assistant focused on interpolating/filling missing code blocks marked by comments starting with '\''##'\''.
Your task is to analyze the entire file provided and find all comment lines starting with optional whitespace followed by '\''##'\'' and some instructions (the indicators).

For each indicator, generate the appropriate code implementation.
You must return a JSON object where:
- Key: The exact literal indicator line starting from '\''##'\'' to the end of the line (excluding any leading spaces/tabs).
- Value: The raw, unindented code block that should replace that indicator line.

Strict Rules:
1. Output ONLY a valid JSON object. Do not include markdown code block formatting (like \`\`\`json). Just start with { and end with }.
2. Do not indent the code inside the JSON value; the runner script will automatically detect the comment'\''s indentation and apply it to every line of your generated code.
3. Ensure your generated code is correct and complete for each placeholder."

PROMPT="Target File Path: $ACTIVE_FILE

--- TARGET FILE CONTENTS ---
$(cat "$ACTIVE_FILE")
--- END TARGET FILE CONTENTS ---"

PAYLOAD_FILE="$AGENT_VSCODE_DIR/payload_fill_$$.json"
jq -n --arg pmt "$PROMPT" --arg sys "$SYS_PROMPT" '{"contents":[{"parts":[{"text": ($sys + "

User Question:
" + $pmt)}]}]}' > "$PAYLOAD_FILE"

if [[ -s "$AGENT_VSCODE_SESSION_DIR/context.txt" ]]; then
    jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/context.txt" '.contents[0].parts[0].text = "Project Context:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
fi

if [[ -s "$TMP_LOGS" ]]; then
    jq --rawfile raw "$TMP_LOGS" '.contents[0].parts[0].text = "Terminal Logs:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
fi

RESPONSE=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/${AGENT_VSCODE_MODEL}:generateContent?key=$GEMINI_API_KEY" \
    -H "Content-Type: application/json" -d @"$PAYLOAD_FILE")
# =====================================================================
# 🛠️ DEBUG SECTION (TEMPORARY - REMOVE LATER)
# =====================================================================
DEBUG_FILE="$AGENT_VSCODE_DIR/fill_debug.txt"
{
  echo "==================== PAYLOAD SENT TO GEMINI ===================="
  cat "$PAYLOAD_FILE"
  echo -e "

==================== RESPONSE RECEIVED FROM GEMINI ===================="
  echo "$RESPONSE"
} > "$DEBUG_FILE"
echo "⚠️  [DEBUG] Saved raw request and response to: $DEBUG_FILE"
# =====================================================================


rm -f "$PAYLOAD_FILE" "$TMP_LOGS"

RESULT=$(echo "$RESPONSE" | jq '.candidates[0].content.parts[0].text // empty')
if [[ -z "$RESULT" ]]; then
    echo "❌ API Error: $(echo "$RESPONSE" | jq -r '.error.message // "Unknown error"')"
    exit 1
fi

TMP_JSON="$AGENT_VSCODE_DIR/tmp_fill_$$.json"
echo "$RESULT" > "$TMP_JSON"

echo "⚡ Interpolating changes with python3..."

python3 -c '
import sys
import json
import re

json_file = sys.argv[1]
file_to_modify = sys.argv[2]

try:
    with open(json_file, "r", encoding="utf-8") as f:
        raw_content = f.read().strip()
    
    # Robustly decode the outer JSON string wrapper if present
    if raw_content.startswith('"') and raw_content.endswith('"'):
        try:
            content = json.loads(raw_content)
        except Exception:
            content = raw_content
    else:
        content = raw_content
        
    content = content.strip()
    if content.startswith("```json"):
        content = content[7:]
    elif content.startswith("```"):
        content = content[3:]
    if content.endswith("```"):
        content = content[:-3]
    content = content.strip()
    
    # strict=False allows literal raw newlines inside JSON string values
    mappings = json.loads(content, strict=False)
except Exception as e:
    print(f"❌ Failed to parse JSON response from LLM: {e}")
    sys.exit(1)

with open(file_to_modify, "r", encoding="utf-8") as f:
    lines = f.readlines()

output_lines = []
interpolations = 0

clean_mappings = {k.strip(): v for k, v in mappings.items()}

for line in lines:
    matched = False
    clean_line = line.rstrip(chr(10)).rstrip(chr(13))
    match = re.match(r"^([      ]*)(##\s*(.*))$", clean_line)
    if match:
        indent = match.group(1)
        indicator = match.group(2).strip()
        
        if indicator in clean_mappings:
            replacement_code = clean_mappings[indicator]
            repl_lines = replacement_code.splitlines()
            for r_line in repl_lines:
                output_lines.append(indent + r_line + chr(10))
            matched = True
            interpolations += 1
            
    if not matched:
        output_lines.append(line)

with open(file_to_modify, "w", encoding="utf-8") as f:
    f.writelines(output_lines)

print(f"   ✔ Successfully interpolated {interpolations} indicators.")
' "$TMP_JSON" "$ACTIVE_FILE"

rm -f "$TMP_JSON"

echo "🔄 Reloading $ACTIVE_FILE into context..."
if [[ -x "$AGENT_VSCODE_DIR/tools/read" ]]; then
    "$AGENT_VSCODE_DIR/tools/read" "$ACTIVE_FILE" >/dev/null 2>&1
fi

echo "🎉 Fill Complete! Editor and Context updated."
