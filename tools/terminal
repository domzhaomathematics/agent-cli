#!/usr/bin/env bash

PROMPT="$*"
if [[ -z "$PROMPT" ]]; then
    exit 0
fi

if [[ -n "$AGENT_VSCODE_SESSION_DIR" ]]; then
    if [[ -x "$AGENT_VSCODE_DIR/tools/update" ]]; then "$AGENT_VSCODE_DIR/tools/update" -q; fi
fi

TMP_LOGS="$AGENT_VSCODE_DIR/tmp_logs_terminal.txt"
if [[ -n "$AGENT_VSCODE_SESSION_DIR" ]]; then
    "$AGENT_VSCODE_DIR/tools/logs" 100 -q > "$TMP_LOGS" 2>/dev/null
else
    > "$TMP_LOGS"
fi

VSCODE_CONTEXT=""
STATE_FILE="$HOME/.agentvscode/active_editor.json"
if [[ -f "$STATE_FILE" ]] && command -v jq &>/dev/null; then
    F_PATH=$(jq -r '.filePath // empty' "$STATE_FILE")
    if [[ -n "$F_PATH" ]]; then
        F_LINE=$(jq -r '.line' "$STATE_FILE")
        F_CHAR=$(jq -r '.character' "$STATE_FILE")
        F_CONTENT=$(jq -r '.lineContent' "$STATE_FILE")
        F_SEL=$(jq -r '.selectedText' "$STATE_FILE")
        
        VSCODE_CONTEXT="==================================================
CURRENT VS CODE ACTIVE EDITOR STATE (LIVE)
==================================================
- Active File: $F_PATH
- Cursor Position: Line $F_LINE, Column $F_CHAR
- Current Cursor Line Content: \"$F_CONTENT\""

        if [[ -n "$F_SEL" ]]; then
            VSCODE_CONTEXT="${VSCODE_CONTEXT}
- Highlighted Selection: \"$F_SEL\""
        fi

        if [[ -f "$F_PATH" ]]; then
            F_FULL_CONTENT=$(cat "$F_PATH" 2>/dev/null)
            VSCODE_CONTEXT="${VSCODE_CONTEXT}

--- FULL FILE CONTENT ($F_PATH) ---
$F_FULL_CONTENT
--- END FULL FILE CONTENT ---"
        fi
        
        VSCODE_CONTEXT="${VSCODE_CONTEXT}
=================================================="
    fi
fi

SYS_PROMPT="You are an automated terminal assistant. The user typed a natural language prompt instead of a terminal command.
Based on the prompt and the provided context, you must determine if they want to execute a command or if they are asking a general question/talking conversationally.

Rules:
1. If they are asking for a shell command to execute (e.g. \"list files\", \"commit my changes\", \"git status\"):
   - Output EXACTLY: COMMAND:<the exact single-line shell command>
   - Do NOT include any explanations or conversational text.
   - Example: COMMAND:git status

2. If they are asking a general question, seeking explanation, or talking conversationally (e.g. \"is this working well\", \"what is git\", \"explain this directory\"):
   - Output EXACTLY: CHAT:<your concise explanation, response, or answer>
   - Example: CHAT:Yes, the agent is connected and working perfectly! Let me know if you need help with any commands.

3. If the request is completely ambiguous or you cannot generate a response, output nothing.

4. VS CODE EDITOR INTEGRATION: You are given full access to the live VS Code editor state, cursor position, selection, and full file contents (under CURRENT VS CODE ACTIVE EDITOR STATE). If the user asks if you can see the file, what is highlighted, where the cursor is, or queries file details, you MUST look at this context and answer accurately. Never claim you cannot see the file contents or position if they are provided."

if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then
    SYS_PROMPT="${SYS_PROMPT}

⚠️ NOTE: Currently, there is NO active workspace session context. Suggest a general command based solely on standard shell tools and the active editor file."
fi

PAYLOAD_FILE="$AGENT_VSCODE_DIR/payload_terminal.json"
jq -n --arg pmt "$PROMPT" --arg sys "$SYS_PROMPT" '{"contents":[{"parts":[{"text": ($sys + "

User Question:
" + $pmt)}]}]}' > "$PAYLOAD_FILE"

if [[ -n "$VSCODE_CONTEXT" ]]; then
    jq --arg ctx "$VSCODE_CONTEXT" '.contents[0].parts[0].text = $ctx + "

" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
fi

if [[ -n "$AGENT_VSCODE_SESSION_DIR" ]]; then
    if [[ -s "$AGENT_VSCODE_SESSION_DIR/context.txt" ]]; then 
        jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/context.txt" '.contents[0].parts[0].text = "Project Context:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
    fi
    if [[ -s "$TMP_LOGS" ]]; then 
        jq --rawfile raw "$TMP_LOGS" '.contents[0].parts[0].text = "Terminal Logs:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
    fi
    if [[ -f "$AGENT_VSCODE_SESSION_DIR/plan.md" ]]; then 
        jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/plan.md" '.contents[0].parts[0].text = "Mission Plan:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
    fi
fi

RESPONSE=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/${AGENT_VSCODE_MODEL}:generateContent?key=$GEMINI_API_KEY" \
    -H "Content-Type: application/json" -d @"$PAYLOAD_FILE")

rm -f "$PAYLOAD_FILE" "$TMP_LOGS"

RESULT=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')

if [[ "$RESULT" =~ ^[Cc][Oo][Mm][Mm][Aa][Nn][Dd]: ]]; then
    CMD_BODY="${RESULT#*:}"
    CLEAN_CMD=$(echo "$CMD_BODY" | sed -E 's/^```[a-zA-Z]*//g; s/```$//g; s/`//g' | tr '
' ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    printf "COMMAND:%s" "$CLEAN_CMD"
elif [[ "$RESULT" =~ ^[Cc][Hh][Aa][Tt]: ]]; then
    CHAT_BODY="${RESULT#*:}"
    CLEAN_CHAT=$(echo "$CHAT_BODY" | sed -E 's/^```[a-zA-Z]*//g; s/```$//g')
    printf "CHAT:%s" "$CLEAN_CHAT"
else
    if [[ -n "$RESULT" ]]; then
        CLEAN_CMD=$(echo "$RESULT" | sed -E 's/^```[a-zA-Z]*//g; s/```$//g; s/`//g' | tr '
' ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        printf "COMMAND:%s" "$CLEAN_CMD"
    fi
fi
