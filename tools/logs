#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] Session not active."; exit 1; fi

LOG_FILE="$AGENT_VSCODE_SESSION_DIR/logs/terminal_raw.log"
if [[ ! -f "$LOG_FILE" ]]; then exit 0; fi

LINES=${1:-1500}
QUIET=0
if [[ "$1" == "-q" || "$2" == "-q" ]]; then QUIET=1; fi

if [[ $QUIET -eq 0 ]]; then echo -e "
--- RAW TERMINAL LOGS (Last $LINES lines) ---"; fi

tail -n "$LINES" "$LOG_FILE" | perl -pe '
    s/[[0-9;?]*[a-zA-Z]//g;
    s/].*?(?:|)//g;
    1 while s/[//g;
    s+//g;
//g;s/
    s///g;
'

if [[ $QUIET -eq 0 ]]; then echo -e "--------------------------------------------------
"; fi
