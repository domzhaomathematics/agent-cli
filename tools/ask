#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] Session not active."; exit 1; fi

if [[ $# -gt 0 ]]; then
    echo "[Warning] 'agent_vscode ask' is interactive. Inline arguments are ignored."
fi

PROMPT=""

while true; do
    if [[ -z "$PROMPT" ]]; then
        echo -e "
💬 Ask Agent [Enter submits. Pasting multi-line text works safely]:"
        read -e -r first_line || exit 0
        PROMPT="$first_line"
        
        while read -t 1 -r extra_line; do
            PROMPT+=$'
'"$extra_line"
        done
    fi
    
    if [[ -z "$(echo -e "$PROMPT" | tr -d '[:space:]')" ]]; then PROMPT=""; continue; fi

    echo -e "
User: $PROMPT"

    TMP_LOGS="$AGENT_VSCODE_DIR/tmp_logs_$$.txt"
    "$AGENT_VSCODE_DIR/tools/logs" > "$TMP_LOGS"
    if [[ -x "$AGENT_VSCODE_DIR/tools/update" ]]; then "$AGENT_VSCODE_DIR/tools/update" -q; fi

    TOK_CTX=$(($(wc -m < "$AGENT_VSCODE_SESSION_DIR/context.txt" 2>/dev/null || echo 0) / 3))
    TOK_LOG=$(($(wc -m < "$TMP_LOGS" 2>/dev/null || echo 0) / 3))
    TOK_TOT=$((TOK_CTX + TOK_LOG))

    echo "[Token Estimate] Total: ${TOK_TOT} | Context: ${TOK_CTX} | Logs: ${TOK_LOG}"

    if (( TOK_TOT > 200000 )); then
        echo "[Alert] Context exceeds 200k tokens. High cost and severe degradation risk."
        echo "Tip: Use 'agent_vscode context' to find large files, and 'agent_vscode unread <path>' to remove them."
        read -e -p "Proceed? [y/N]: " proceed
        if [[ ! "$proceed" =~ ^[Yy]$ ]]; then rm -f "$TMP_LOGS"; PROMPT=""; continue; fi
    elif (( TOK_TOT > 100000 )); then
        echo "[Warning] Context exceeds 100k tokens. Performance may degrade."
    fi

    echo "Thinking (Model: $AGENT_VSCODE_MODEL)..."

    SYS_PROMPT="You are a precise, highly skilled coding assistant. You must provide concise, dense text explanations. Do not use conversational filler. The explanation should be about which step you will execute in the plan (if not all), how you will do it, and if there is user feedback, you should reference the user feedback, and incorporate it into your explanation. If you are unsure about something , you can ask the user, but only ask if something is really ambiguous, or not possible to execute (no access,etc).
If actions (creating files, executing commands) are required, output AT MOST ONE \`bash\` code block (using \`\`\`bash).
Even if multiple files need creating or editing, combine them into this SINGLE script using \`cat << 'EOF'\`, \`sed\`, or other shell utilities. Provide exactly one bash block if code execution is needed."

    PAYLOAD_FILE="$AGENT_VSCODE_DIR/payload.json"
    jq -n --arg pmt "$PROMPT" --arg sys "$SYS_PROMPT" '{"contents":[{"parts":[{"text": ($sys + "

User Question:
" + $pmt)}]}]}' > "$PAYLOAD_FILE"

    if [[ -s "$AGENT_VSCODE_SESSION_DIR/context.txt" ]]; then jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/context.txt" '.contents[0].parts[0].text = "Project Context:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    if [[ -s "$TMP_LOGS" ]]; then jq --rawfile raw "$TMP_LOGS" '.contents[0].parts[0].text = "Terminal Logs:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    if [[ -f "$AGENT_VSCODE_SESSION_DIR/plan.md" ]]; then jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/plan.md" '.contents[0].parts[0].text = "Mission Plan:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi

    RESPONSE=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/${AGENT_VSCODE_MODEL}:generateContent?key=$GEMINI_API_KEY" \
        -H "Content-Type: application/json" -d @"$PAYLOAD_FILE")

    rm -f "$PAYLOAD_FILE" "$TMP_LOGS"

    RESULT=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')
    if [[ -z "$RESULT" ]]; then
        echo "[API Error] $(echo "$RESPONSE" | jq -r '.error.message // "Unknown Error"')"
        PROMPT=""
        continue
    fi

    TEXT_PART=$(echo "$RESULT" | awk '/^```bash/ { in_code = 1; next } /^```/ { if (in_code) { in_code = 0; next } } { if (!in_code) print }')
    SCRIPT_PART=$(echo "$RESULT" | awk '/^```bash/ { in_code = 1; next } /^```/ { if (in_code) { in_code = 0; next } } { if (in_code) print }')

    echo -e "
$TEXT_PART
"

    if [[ -n "$SCRIPT_PART" && "$SCRIPT_PART" != $'
' ]]; then
        echo "---[ SCRIPT BLOCK START ]---"
        echo "$SCRIPT_PART"
        echo "---[ SCRIPT BLOCK END ]---"
        echo ""
        
        while read -t 0; do read -r; done
        
        echo -ne "🚀 [Enter] to run script | [Ctrl+C] to exit | [f] to write feedback: "
        read -e -r DECISION || exit 0
        
        if [[ -z "$DECISION" ]]; then
            TMP_SCRIPT="$AGENT_VSCODE_DIR/tmp_run.sh"
            echo "$SCRIPT_PART" > "$TMP_SCRIPT"
            chmod +x "$TMP_SCRIPT"
            echo -e "
[Executing Script...]"
            bash "$TMP_SCRIPT"
            rm -f "$TMP_SCRIPT"
            echo -e "[Execution Complete]
"
            PROMPT=""
        elif [[ "$DECISION" == "f" || "$DECISION" == "F" ]]; then
            echo -e "
📝 Enter Feedback:"
            read -e -r first_line || exit 0
            PROMPT="$first_line"
            while read -t 1 -r extra_line; do
                PROMPT+=$'
'"$extra_line"
            done
        else
            PROMPT="$DECISION"
        fi
    else
        PROMPT=""
    fi
done
