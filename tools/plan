#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] Session not active."; exit 1; fi
export AGENT_VSCODE_MODEL="gemini-3.1-pro-preview"

GOAL="$*"
if [[ -z "$GOAL" ]]; then 
    echo -e "
🎯 What is your goal? [Enter submits. Pasting multi-line text works safely]:"
    read -e -r first_line || exit 0
    GOAL="$first_line"
    while read -t 1 -r extra_line; do
        GOAL+=$'
'"$extra_line"
    done
fi

CURRENT_PROPOSAL=""
FEEDBACK=""

while true; do
    TMP_LOGS="$AGENT_VSCODE_DIR/tmp_logs_$$.txt"
    "$AGENT_VSCODE_DIR/tools/logs" 150 -q > "$TMP_LOGS"
    if [[ -x "$AGENT_VSCODE_DIR/tools/update" ]]; then "$AGENT_VSCODE_DIR/tools/update" -q; fi

    TOK_CTX=$(($(wc -m < "$AGENT_VSCODE_SESSION_DIR/context.txt" 2>/dev/null || echo 0) / 3))
    TOK_LOG=$(($(wc -m < "$TMP_LOGS" 2>/dev/null || echo 0) / 3))
    TOK_TOT=$((TOK_CTX + TOK_LOG))

    echo "[Token Estimate] Total: ${TOK_TOT} | Context: ${TOK_CTX} | Logs: ${TOK_LOG}"

    if (( TOK_TOT > 200000 )); then
        read -e -p "[Alert] Context > 200k tokens. Proceed? [y/N]: " proceed
        if [[ ! "$proceed" =~ ^[Yy]$ ]]; then rm -f "$TMP_LOGS"; exit 0; fi
    elif (( TOK_TOT > 100000 )); then
        echo "[Warning] Context exceeds 100k tokens."
    fi

    echo "Thinking (Model: $AGENT_VSCODE_MODEL)..."
    
    EXISTING_PLAN=""
    if [[ -f "$AGENT_VSCODE_SESSION_DIR/plan.md" ]]; then
        EXISTING_PLAN="--- EXISTING MISSION PLAN ---
$(cat "$AGENT_VSCODE_SESSION_DIR/plan.md")
---------------------------"
    fi

    PROMPT="You are a Senior Developer and project planner, you help juniors execute their tasks effectively by figuring out the best overall approach. In your plans you are precise and concise, you break down the problem into clear steps and avoid unnecessary verbosity. You clearly reference the exiting repo/and files formt the context and terminal logs when relevant, such that any junior developer could pick up the plan and execute it without confusion.
NEW GOAL / REQUEST: $GOAL
${FEEDBACK:+USER FEEDBACK ON PREVIOUS DRAFT: $FEEDBACK}

INSTRUCTIONS:
1. If an EXISTING MISSION PLAN is provided, heavily factor it into your response. Update, refine, or rewrite it based on the NEW GOAL and context.
2. If the new goal is an addition, adapt the existing plan accordingly.
3. If there is no existing plan, create one from scratch.

FORMAT REQUIREMENTS:
1. '## Goal': A single, concise paragraph defining the objective.
2. '## The Plan': A numbered list of sequential steps.
3. '## Completion Criteria': Explicitly state how we know this goal is finished.
Output ONLY the Markdown content."

    PAYLOAD_FILE="$AGENT_VSCODE_DIR/payload.json"
    jq -n --arg pmt "$PROMPT" '{"contents":[{"parts":[{"text": $pmt}]}]}' > "$PAYLOAD_FILE"
    
    if [[ -s "$AGENT_VSCODE_SESSION_DIR/context.txt" ]]; then jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/context.txt" '.contents[0].parts[0].text = "Project Context:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    if [[ -s "$TMP_LOGS" ]]; then jq --rawfile raw "$TMP_LOGS" '.contents[0].parts[0].text = "Terminal Logs:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    
    RESPONSE=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/${AGENT_VSCODE_MODEL}:generateContent?key=$GEMINI_API_KEY" \
      -H "Content-Type: application/json" -d @"$PAYLOAD_FILE")
    
    CURRENT_PROPOSAL=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')
    
    rm -f "$PAYLOAD_FILE" "$TMP_LOGS"
    
    if [[ -z "$CURRENT_PROPOSAL" ]]; then echo "[API Error] $(echo "$RESPONSE" | jq -r '.error.message // "Unknown error"')"; exit 1; fi
    
    echo -e "
==================== PROPOSED PLAN ====================
"
    echo "$CURRENT_PROPOSAL"
    echo -e "
======================================================="
    
    while read -t 0; do read -r; done
    
    echo -ne "🚀 [Enter] to Accept | [Ctrl+C] to Cancel | [f] to refine/feedback: "
    read -e -r DECISION || exit 0
    
    if [[ -z "$DECISION" ]]; then
        echo "$CURRENT_PROPOSAL" > "$AGENT_VSCODE_SESSION_DIR/plan.md"
        echo -e "
[Success] Plan saved to plan.md!"
        break
    elif [[ "$DECISION" == "f" || "$DECISION" == "F" ]]; then
        echo -e "
📝 Enter Feedback:"
        read -e -r first_line || exit 0
        FEEDBACK="$first_line"
        while read -t 1 -r extra_line; do
            FEEDBACK+=$'
'"$extra_line"
        done
    else
        FEEDBACK="$DECISION"
    fi
done
