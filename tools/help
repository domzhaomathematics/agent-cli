#!/usr/bin/env bash
if [[ -n "$AGENT_VSCODE_SESSION_NAME" ]]; then S_DISPLAY="$AGENT_VSCODE_SESSION_NAME"; else S_DISPLAY="None (Global Mode)"; fi

echo -e "
🤖 Agent VS Code Decoupled Integration"
echo "Current Session: [$S_DISPLAY]"
echo "Current Model:   $AGENT_VSCODE_MODEL"

echo -e "
--- 🧠 Brain & Context ---"
echo "  read <path>           : Load file/dir into context"
echo "  unread <path>         : Surgically remove file/dir from context"
echo "  update                : Sync all files with live disk states"
echo "  clear                 : Wipe context for current session"
echo "  context               : Dashboard showing loaded files/tokens"

echo -e "
--- 💬 Interaction ---"
echo "  plan <goal>           : Build a mission plan (plan.md)"
echo "  ask                   : Ask Gemini using loaded context"
echo "  terminal <prompt>     : Suggest single-line terminal commands"

echo -e "
--- 🏗️ Workspaces ---"
echo "  start <name>          : Create and bind to a new workspace"
echo "  resume <name>         : Bind terminal to an existing workspace"
echo "  stop                  : Unbind and return to Global mode"
echo "  list                  : Show all sessions"
echo "  delete <name>         : Delete a session"
echo ""
