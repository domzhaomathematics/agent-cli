#!/usr/bin/env bash

# Hardcoded absolute path for the target VS Code Repository to prevent any CLI cross-clashes
TARGET_REPO="/Users/dominiczhao/agentvscode"
cd "$TARGET_REPO" || { echo "❌ Directory $TARGET_REPO not found."; exit 1; }

echo '[1/4] Writing isolated and decoupled tool implementations...'

# Overwrite main entrypoint
cat << 'EOF' > "$TARGET_REPO/agent_vscode"
#!/usr/bin/env bash
export AGENT_VSCODE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]:-$0}")")"
mkdir -p "$AGENT_VSCODE_DIR/sessions/.bindings"

# Resolve Session (With Ghost-Tab Protection & Log Cleanup)
if [[ -z "$AGENT_VSCODE_SESSION_RESOLVED" ]]; then
    CURRENT_TTY=$(tty | sed 's|/|_|g')
    BINDING_FILE="$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"
    if [[ -f "$BINDING_FILE" ]]; then
        BIND_DATA=$(cat "$BINDING_FILE")
        B_NAME="${BIND_DATA%:*}"
        B_PID="${BIND_DATA#*:}"
        
        if [[ -z "$B_PID" || "$B_PID" == "$B_NAME" ]] || ps -p "$B_PID" >/dev/null 2>&1; then
            export AGENT_VSCODE_SESSION_NAME="$B_NAME"
            export AGENT_VSCODE_SESSION_DIR="$AGENT_VSCODE_DIR/sessions/$B_NAME"
        else
            rm -f "$AGENT_VSCODE_DIR/sessions/$B_NAME/logs/terminal_raw.log"
            rm -f "$BINDING_FILE"
        fi
    fi
    export AGENT_VSCODE_SESSION_RESOLVED="1"
fi

# Handle Model Tiers (Defaults to gemini-3.5-flash)
export AGENT_VSCODE_MODEL="gemini-3.5-flash"
NEW_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "-s" || "$arg" == "-smartest" ]]; then
        export AGENT_VSCODE_MODEL="gemini-3.1-pro-preview"
    else
        NEW_ARGS+=("$arg")
    fi
done
set -- "${NEW_ARGS[@]}"

COMMAND="$1"
shift
[[ -z "$COMMAND" ]] && COMMAND="help"

# Session Enforcement
PUBLIC_CMDS="help start resume list delete stop ask terminal"
if [[ -z "$AGENT_VSCODE_SESSION_NAME" ]]; then
    if [[ ! " $PUBLIC_CMDS " =~ " $COMMAND " ]]; then
        echo "❌ Error: No active session found. Run 'agent_vscode start <name>' first."
        exit 1
    fi
fi

# Routing
if [[ -x "$AGENT_VSCODE_DIR/tools/$COMMAND" ]]; then exec "$AGENT_VSCODE_DIR/tools/$COMMAND" "$@"
elif [[ -x "$AGENT_VSCODE_DIR/manage/$COMMAND" ]]; then exec "$AGENT_VSCODE_DIR/manage/$COMMAND" "$@"
else
    echo "❌ Error: Command '$COMMAND' not found."
    exit 1
fi
EOF

# Ensure directory structures are present
mkdir -p "$TARGET_REPO/tools" "$TARGET_REPO/manage"

# tools/context
cat << 'EOF' > "$TARGET_REPO/tools/context"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "❌ Error: Session not active."; exit 1; fi
OUT_FILE="$AGENT_VSCODE_SESSION_DIR/context.txt"
if [[ ! -s "$OUT_FILE" ]]; then echo "Brain is empty."; exit 0; fi

echo -e "
📊 ANALYZING CONTEXT WEIGHT..."

LC_ALL=C awk -v cwd="$(pwd)" '
BEGIN {
    FS="|"; 
    printf "
📂 TOP-LEVEL FOLDERS (Aggregated)
"
    printf "%-12s %-8s %-s
", "TOKENS", "FILES", "DIRECTORY"
    printf "--------------------------------------------------------------------------------
"
}
/---\[ FILE:/ {
    p = $1; sub(/---\[ FILE: /, "", p); sub(/ $/, "", p);
    t = $2; sub(/ Tokens: /, "", t); sub(/ $/, "", t);
    m = $3; sub(/ Mode: /, "", m); sub(/ \]---/, "", m); sub(/ $/, "", m);

    rel = p; gsub(cwd "/", "./", rel);

    split(rel, pts, "/");
    if (rel ~ /\// && pts[2] != "") { top = pts[1] "/" pts[2] "/"; }
    else { top = "./ (root)"; }

    tokens[rel] = t + 0;
    modes[rel] = m;
    dir_tokens[top] += t;
    dir_counts[top] += 1;
    total_t += t;
    total_f += 1;
}
END {
    for (d in dir_tokens) {
        printf "%-12d %-8d %s
", dir_tokens[d], dir_counts[d], d | "sort -rn | head -n 5"
    }
    close("sort -rn | head -n 5")

    printf "
📄 HEAVIEST INDIVIDUAL FILES
"
    printf "%-12s %-8s %-s
", "TOKENS", "MODE", "FILE PATH"
    printf "--------------------------------------------------------------------------------
"
    for (f in tokens) {
        printf "%-12d %-8s %s
", tokens[f], modes[f], f | "sort -rn | head -n 15"
    }
    close("sort -rn | head -n 15")

    printf "--------------------------------------------------------------------------------
"
    printf "TOTAL CONTEXT: ~%d tokens across %d files

", total_t, total_f
}' "$OUT_FILE"
EOF

# tools/update
cat << 'EOF' > "$TARGET_REPO/tools/update"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "❌ Error: Session not active."; exit 1; fi
OUT_FILE="$AGENT_VSCODE_SESSION_DIR/context.txt"
if [[ ! -s "$OUT_FILE" ]]; then exit 0; fi

TMP_OUT="$AGENT_VSCODE_SESSION_DIR/context_tmp.txt"
> "$TMP_OUT"

UPDATED=0
DELETED=0

while IFS='|' read -r p1 p2 p3; do
    FILE_PATH=$(echo "$p1" | sed 's/^---\[ FILE: //; s/ *$//')
    MODE=$(echo "$p3" | sed 's/^ Mode: //; s/ \]---$//; s/ *$//')

    if [[ -f "$FILE_PATH" ]]; then
        SIZE_BYTES=$(wc -c < "$FILE_PATH" 2>/dev/null || echo 0)
        if (( SIZE_BYTES > 1048576 )); then
            ((DELETED++))
            continue
        fi

        if [[ "$MODE" == "PATH_ONLY" ]]; then
            echo "---[ FILE: $FILE_PATH | Tokens: 5 | Mode: PATH_ONLY ]---" >> "$TMP_OUT"
            echo "---[ END: $FILE_PATH ]---" >> "$TMP_OUT"
        else
            CHARS=$(LC_ALL=C wc -m < "$FILE_PATH" 2>/dev/null || echo 0)
            TK=$((CHARS / 3))
            echo "---[ FILE: $FILE_PATH | Tokens: $TK | Mode: FULL ]---" >> "$TMP_OUT"
            cat "$FILE_PATH" >> "$TMP_OUT"
            echo -e "
---[ END: $FILE_PATH ]---" >> "$TMP_OUT"
        fi
        ((UPDATED++))
    else
        ((DELETED++))
    fi
done < <(awk 'BEGIN {FS="|"} /^---\[ FILE: / { print $1 "|" $2 "|" $3 }' "$OUT_FILE")

mv "$TMP_OUT" "$OUT_FILE"

if [[ "$1" != "-q" ]]; then
    echo "[Session: $AGENT_VSCODE_SESSION_NAME] 🔄 Context synced ($UPDATED files updated, $DELETED removed)."
fi
EOF

# tools/ask
cat << 'EOF' > "$TARGET_REPO/tools/ask"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] Session not active."; exit 1; fi

if [[ $# -gt 0 ]]; then
    echo "[Warning] 'agent_vscode ask' is interactive. Inline arguments are ignored."
fi

PROMPT=""

while true; do
    if [[ -z "$PROMPT" ]]; then
        echo -e "
💬 Ask Agent [Enter submits. Pasting multi-line text works safely]:"
        read -e -r first_line || exit 0
        PROMPT="$first_line"
        
        while read -t 1 -r extra_line; do
            PROMPT+=$'
'"$extra_line"
        done
    fi
    
    if [[ -z "$(echo -e "$PROMPT" | tr -d '[:space:]')" ]]; then PROMPT=""; continue; fi

    echo -e "
User: $PROMPT"

    TMP_LOGS="$AGENT_VSCODE_DIR/tmp_logs.txt"
    "$AGENT_VSCODE_DIR/tools/logs" > "$TMP_LOGS"
    if [[ -x "$AGENT_VSCODE_DIR/tools/update" ]]; then "$AGENT_VSCODE_DIR/tools/update" -q; fi

    TOK_CTX=$(($(wc -m < "$AGENT_VSCODE_SESSION_DIR/context.txt" 2>/dev/null || echo 0) / 3))
    TOK_LOG=$(($(wc -m < "$TMP_LOGS" 2>/dev/null || echo 0) / 3))
    TOK_TOT=$((TOK_CTX + TOK_LOG))

    echo "[Token Estimate] Total: ${TOK_TOT} | Context: ${TOK_CTX} | Logs: ${TOK_LOG}"

    if (( TOK_TOT > 200000 )); then
        echo "[Alert] Context exceeds 200k tokens. High cost and severe degradation risk."
        echo "Tip: Use 'agent_vscode context' to find large files, and 'agent_vscode unread <path>' to remove them."
        read -e -p "Proceed? [y/N]: " proceed
        if [[ ! "$proceed" =~ ^[Yy]$ ]]; then rm -f "$TMP_LOGS"; PROMPT=""; continue; fi
    elif (( TOK_TOT > 100000 )); then
        echo "[Warning] Context exceeds 100k tokens. Performance may degrade."
    fi

    echo "Thinking (Model: $AGENT_VSCODE_MODEL)..."

    SYS_PROMPT="You are a precise, highly skilled coding assistant. You must provide concise, dense text explanations. Do not use conversational filler. The explanation should be about which step you will execute in the plan (if not all), how you will do it, and if there is user feedback, you should reference the user feedback, and incorporate it into your explanation. If you are unsure about something , you can ask the user, but only ask if something is really ambiguous, or not possible to execute (no access,etc).
If actions (creating files, executing commands) are required, output AT MOST ONE \`bash\` code block (using \`\`\`bash).
Even if multiple files need creating or editing, combine them into this SINGLE script using \`cat << 'EOF'\`, \`sed\`, or other shell utilities. Provide exactly one bash block if code execution is needed."

    PAYLOAD_FILE="$AGENT_VSCODE_DIR/payload.json"
    jq -n --arg pmt "$PROMPT" --arg sys "$SYS_PROMPT" '{"contents":[{"parts":[{"text": ($sys + "

User Question:
" + $pmt)}]}]}' > "$PAYLOAD_FILE"

    if [[ -s "$AGENT_VSCODE_SESSION_DIR/context.txt" ]]; then jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/context.txt" '.contents[0].parts[0].text = "Project Context:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    if [[ -s "$TMP_LOGS" ]]; then jq --rawfile raw "$TMP_LOGS" '.contents[0].parts[0].text = "Terminal Logs:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    if [[ -f "$AGENT_VSCODE_SESSION_DIR/plan.md" ]]; then jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/plan.md" '.contents[0].parts[0].text = "Mission Plan:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi

    RESPONSE=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/${AGENT_VSCODE_MODEL}:generateContent?key=$GEMINI_API_KEY" \
        -H "Content-Type: application/json" -d @"$PAYLOAD_FILE")

    rm -f "$PAYLOAD_FILE" "$TMP_LOGS"

    RESULT=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')
    if [[ -z "$RESULT" ]]; then
        echo "[API Error] $(echo "$RESPONSE" | jq -r '.error.message // "Unknown Error"')"
        PROMPT=""
        continue
    fi

    TEXT_PART=$(echo "$RESULT" | awk '/^```bash/ { in_code = 1; next } /^```/ { if (in_code) { in_code = 0; next } } { if (!in_code) print }')
    SCRIPT_PART=$(echo "$RESULT" | awk '/^```bash/ { in_code = 1; next } /^```/ { if (in_code) { in_code = 0; next } } { if (in_code) print }')

    echo -e "
$TEXT_PART
"

    if [[ -n "$SCRIPT_PART" && "$SCRIPT_PART" != $'
' ]]; then
        echo "---[ SCRIPT BLOCK START ]---"
        echo "$SCRIPT_PART"
        echo "---[ SCRIPT BLOCK END ]---"
        echo ""
        
        while read -t 0; do read -r; done
        
        echo -ne "🚀 [Enter] to run script | [Ctrl+C] to exit | [f] to write feedback: "
        read -e -r DECISION || exit 0
        
        if [[ -z "$DECISION" ]]; then
            TMP_SCRIPT="$AGENT_VSCODE_DIR/tmp_run.sh"
            echo "$SCRIPT_PART" > "$TMP_SCRIPT"
            chmod +x "$TMP_SCRIPT"
            echo -e "
[Executing Script...]"
            bash "$TMP_SCRIPT"
            rm -f "$TMP_SCRIPT"
            echo -e "[Execution Complete]
"
            PROMPT=""
        elif [[ "$DECISION" == "f" || "$DECISION" == "F" ]]; then
            echo -e "
📝 Enter Feedback:"
            read -e -r first_line || exit 0
            PROMPT="$first_line"
            while read -t 1 -r extra_line; do
                PROMPT+=$'
'"$extra_line"
            done
        else
            PROMPT="$DECISION"
        fi
    else
        PROMPT=""
    fi
done
EOF

# tools/plan
cat << 'EOF' > "$TARGET_REPO/tools/plan"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] Session not active."; exit 1; fi
export AGENT_VSCODE_MODEL="gemini-3.1-pro-preview"

GOAL="$*"
if [[ -z "$GOAL" ]]; then 
    echo -e "
🎯 What is your goal? [Enter submits. Pasting multi-line text works safely]:"
    read -e -r first_line || exit 0
    GOAL="$first_line"
    while read -t 1 -r extra_line; do
        GOAL+=$'
'"$extra_line"
    done
fi

CURRENT_PROPOSAL=""
FEEDBACK=""

while true; do
    TMP_LOGS="$AGENT_VSCODE_DIR/tmp_logs.txt"
    "$AGENT_VSCODE_DIR/tools/logs" 150 -q > "$TMP_LOGS"
    if [[ -x "$AGENT_VSCODE_DIR/tools/update" ]]; then "$AGENT_VSCODE_DIR/tools/update" -q; fi

    TOK_CTX=$(($(wc -m < "$AGENT_VSCODE_SESSION_DIR/context.txt" 2>/dev/null || echo 0) / 3))
    TOK_LOG=$(($(wc -m < "$TMP_LOGS" 2>/dev/null || echo 0) / 3))
    TOK_TOT=$((TOK_CTX + TOK_LOG))

    echo "[Token Estimate] Total: ${TOK_TOT} | Context: ${TOK_CTX} | Logs: ${TOK_LOG}"

    if (( TOK_TOT > 200000 )); then
        read -e -p "[Alert] Context > 200k tokens. Proceed? [y/N]: " proceed
        if [[ ! "$proceed" =~ ^[Yy]$ ]]; then rm -f "$TMP_LOGS"; exit 0; fi
    elif (( TOK_TOT > 100000 )); then
        echo "[Warning] Context exceeds 100k tokens."
    fi

    echo "Thinking (Model: $AGENT_VSCODE_MODEL)..."
    
    EXISTING_PLAN=""
    if [[ -f "$AGENT_VSCODE_SESSION_DIR/plan.md" ]]; then
        EXISTING_PLAN="--- EXISTING MISSION PLAN ---
$(cat "$AGENT_VSCODE_SESSION_DIR/plan.md")
---------------------------"
    fi

    PROMPT="You are a Senior Developer and project planner, you help juniors execute their tasks effectively by figuring out the best overall approach. In your plans you are precise and concise, you break down the problem into clear steps and avoid unnecessary verbosity. You clearly reference the exiting repo/and files formt the context and terminal logs when relevant, such that any junior developer could pick up the plan and execute it without confusion.
NEW GOAL / REQUEST: $GOAL
${FEEDBACK:+USER FEEDBACK ON PREVIOUS DRAFT: $FEEDBACK}

INSTRUCTIONS:
1. If an EXISTING MISSION PLAN is provided, heavily factor it into your response. Update, refine, or rewrite it based on the NEW GOAL and context.
2. If the new goal is an addition, adapt the existing plan accordingly.
3. If there is no existing plan, create one from scratch.

FORMAT REQUIREMENTS:
1. '## Goal': A single, concise paragraph defining the objective.
2. '## The Plan': A numbered list of sequential steps.
3. '## Completion Criteria': Explicitly state how we know this goal is finished.
Output ONLY the Markdown content."

    PAYLOAD_FILE="$AGENT_VSCODE_DIR/payload.json"
    jq -n --arg pmt "$PROMPT" '{"contents":[{"parts":[{"text": $pmt}]}]}' > "$PAYLOAD_FILE"
    
    if [[ -s "$AGENT_VSCODE_SESSION_DIR/context.txt" ]]; then jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/context.txt" '.contents[0].parts[0].text = "Project Context:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    if [[ -s "$TMP_LOGS" ]]; then jq --rawfile raw "$TMP_LOGS" '.contents[0].parts[0].text = "Terminal Logs:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"; fi
    
    RESPONSE=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/${AGENT_VSCODE_MODEL}:generateContent?key=$GEMINI_API_KEY" \
      -H "Content-Type: application/json" -d @"$PAYLOAD_FILE")
    
    CURRENT_PROPOSAL=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')
    
    rm -f "$PAYLOAD_FILE" "$TMP_LOGS"
    
    if [[ -z "$CURRENT_PROPOSAL" ]]; then echo "[API Error] $(echo "$RESPONSE" | jq -r '.error.message // "Unknown error"')"; exit 1; fi
    
    echo -e "
==================== PROPOSED PLAN ====================
"
    echo "$CURRENT_PROPOSAL"
    echo -e "
======================================================="
    
    while read -t 0; do read -r; done
    
    echo -ne "🚀 [Enter] to Accept | [Ctrl+C] to Cancel | [f] to refine/feedback: "
    read -e -r DECISION || exit 0
    
    if [[ -z "$DECISION" ]]; then
        echo "$CURRENT_PROPOSAL" > "$AGENT_VSCODE_SESSION_DIR/plan.md"
        echo -e "
[Success] Plan saved to plan.md!"
        break
    elif [[ "$DECISION" == "f" || "$DECISION" == "F" ]]; then
        echo -e "
📝 Enter Feedback:"
        read -e -r first_line || exit 0
        FEEDBACK="$first_line"
        while read -t 1 -r extra_line; do
            FEEDBACK+=$'
'"$extra_line"
        done
    else
        FEEDBACK="$DECISION"
    fi
done
EOF

# tools/read
cat << 'EOF' > "$TARGET_REPO/tools/read"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] No session active."; exit 1; fi

TARGET="."
EXCEPT=""
ONLY_PATHS=false

ARGS=()
while [[ "$#" -gt 0 ]]; do
    if [[ "$1" == "except" ]]; then
        EXCEPT="$2"
        shift 2
    elif [[ "$1" == "--only-paths" ]]; then
        ONLY_PATHS=true
        shift
    else
        ARGS+=("$1")
        shift
    fi
done

if [[ ${#ARGS[@]} -gt 0 ]]; then TARGET="${ARGS[0]}"; fi

ABS_TARGET=$(realpath "$TARGET" 2>/dev/null || echo "$TARGET")
OUT_FILE="$AGENT_VSCODE_SESSION_DIR/context.txt"
touch "$OUT_FILE"

process_file() {
    local abs_f=$(realpath "$1")
    local rel_f="./${abs_f#$PWD/}"
    local is_update=false
    
    if [[ "$abs_f" == "$AGENT_VSCODE_DIR/sessions/"* ]]; then return; fi
    
    if grep -q -F -e "---[ FILE: $abs_f |" "$OUT_FILE"; then
        "$AGENT_VSCODE_DIR/tools/unread" "$abs_f" >/dev/null 2>&1
        is_update=true
    fi

    local size_bytes=$(wc -c < "$abs_f" 2>/dev/null || echo 0)
    if (( size_bytes > 1048576 )); then echo "   [Skipped >1MB] $rel_f"; return; fi

    if [[ -s "$abs_f" ]]; then
        local enc=$(file -b --mime-encoding "$abs_f" 2>/dev/null)
        if [[ "$enc" == "binary" ]]; then return; fi
    fi

    if [[ "$ONLY_PATHS" == true ]]; then
        echo "---[ FILE: $abs_f | Tokens: 5 | Mode: PATH_ONLY ]---" >> "$OUT_FILE"
        echo "---[ END: $abs_f ]---" >> "$OUT_FILE"
        if [[ "$is_update" == true ]]; then echo "   [Updated Path] $rel_f"; else echo "   [Path Only] $rel_f"; fi
    else
        local chars=$(wc -m < "$abs_f" 2>/dev/null || echo 0)
        local tk=$((chars / 3))
        echo "---[ FILE: $abs_f | Tokens: $tk | Mode: FULL ]---" >> "$OUT_FILE"
        cat "$abs_f" >> "$OUT_FILE"
        echo -e "
---[ END: $abs_f ]---" >> "$OUT_FILE"
        
        if [[ "$is_update" == true ]]; then echo "   [Updated] $rel_f (~$tk tokens)"; else echo "   [Added] $rel_f (~$tk tokens)"; fi
    fi
}

FIND_CMD=(find "$ABS_TARGET" -type f -not -path '*/.*' -not -path '*/node_modules/*' -not -path '*/venv/*' -not -path '*/env/*' -not -path '*/__pycache__/*' -not -path '*/dist/*' -not -path '*/build/*')
if [[ -n "$EXCEPT" ]]; then
    IFS=',' read -ra ADDR <<< "$EXCEPT"
    for part in "${ADDR[@]}"; do FIND_CMD+=(-not -path "*/$part/*" -not -name "$part"); done
fi

if [[ -f "$ABS_TARGET" ]]; then process_file "$ABS_TARGET"
else while read -r file; do process_file "$file"; done < <("${FIND_CMD[@]}" 2>/dev/null); fi
EOF

# tools/clear
cat << 'EOF' > "$TARGET_REPO/tools/clear"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "❌ Error: Session not active."; exit 1; fi
> "$AGENT_VSCODE_SESSION_DIR/context.txt"
echo "[Session: $AGENT_VSCODE_SESSION_NAME] ✨ Context cleared!"
EOF

# tools/logs
cat << 'EOF' > "$TARGET_REPO/tools/logs"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "[Error] Session not active."; exit 1; fi

LOG_FILE="$AGENT_VSCODE_SESSION_DIR/logs/terminal_raw.log"
if [[ ! -f "$LOG_FILE" ]]; then exit 0; fi

LINES=${1:-1500}
QUIET=0
if [[ "$1" == "-q" || "$2" == "-q" ]]; then QUIET=1; fi

if [[ $QUIET -eq 0 ]]; then echo -e "
--- RAW TERMINAL LOGS (Last $LINES lines) ---"; fi

tail -n "$LINES" "$LOG_FILE" | perl -pe '
    s/[[0-9;?]*[a-zA-Z]//g;
    s/].*?(?:|)//g;
    1 while s/[//g;
    s+//g;
//g;s/
    s///g;
'

if [[ $QUIET -eq 0 ]]; then echo -e "--------------------------------------------------
"; fi
EOF

# tools/help
cat << 'EOF' > "$TARGET_REPO/tools/help"
#!/usr/bin/env bash
if [[ -n "$AGENT_VSCODE_SESSION_NAME" ]]; then S_DISPLAY="$AGENT_VSCODE_SESSION_NAME"; else S_DISPLAY="None (Global Mode)"; fi

echo -e "
🤖 Agent VS Code Decoupled Integration"
echo "Current Session: [$S_DISPLAY]"
echo "Current Model:   $AGENT_VSCODE_MODEL"

echo -e "
--- 🧠 Brain & Context ---"
echo "  read <path>           : Load file/dir into context"
echo "  unread <path>         : Surgically remove file/dir from context"
echo "  update                : Sync all files with live disk states"
echo "  clear                 : Wipe context for current session"
echo "  context               : Dashboard showing loaded files/tokens"

echo -e "
--- 💬 Interaction ---"
echo "  plan <goal>           : Build a mission plan (plan.md)"
echo "  ask                   : Ask Gemini using loaded context"
echo "  terminal <prompt>     : Suggest single-line terminal commands"

echo -e "
--- 🏗️ Workspaces ---"
echo "  start <name>          : Create and bind to a new workspace"
echo "  resume <name>         : Bind terminal to an existing workspace"
echo "  stop                  : Unbind and return to Global mode"
echo "  list                  : Show all sessions"
echo "  delete <name>         : Delete a session"
echo ""
EOF

# tools/unread
cat << 'EOF' > "$TARGET_REPO/tools/unread"
#!/usr/bin/env bash
if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then echo "❌ Error: Session not active."; exit 1; fi

TARGET="${1:-.}"
ABS_TARGET=$(realpath "$TARGET")
OUT_FILE="$AGENT_VSCODE_SESSION_DIR/context.txt"

if [[ ! -s "$OUT_FILE" ]]; then
    echo "Brain is already empty."
    exit 0
fi

if [[ "$ABS_TARGET" == "$PWD" ]]; then
    REL_PATH="."
else
    REL_PATH="./${ABS_TARGET#$PWD/}"
fi

if [[ -d "$ABS_TARGET" ]]; then
    IS_DIR=1
else
    IS_DIR=0
fi

BEFORE=$(grep -c -e "^---\[ FILE: " "$OUT_FILE" 2>/dev/null || echo 0)

awk -v target="$ABS_TARGET" -v is_dir="$IS_DIR" '
BEGIN { skip = 0 }
/^---\[ FILE: / {
    p = $0; sub(/^---\[ FILE: /, "", p); sub(/ \|.*$/, "", p);
    if (is_dir == 1) {
        if (p == target || index(p, target "/") == 1) {
            skip = 1;
        }
    } else {
        if (p == target) {
            skip = 1;
        }
    }
}
{
    if (skip == 0) print $0
}
/^---\[ END: / {
    if (skip == 1) skip = 0
}' "$OUT_FILE" > "${OUT_FILE}.tmp" && mv "${OUT_FILE}.tmp" "$OUT_FILE"

AFTER=$(grep -c -e "^---\[ FILE: " "$OUT_FILE" 2>/dev/null || echo 0)
REMOVED=$((BEFORE - AFTER))

if [[ "$IS_DIR" -eq 1 ]]; then
    echo "   - [Removed Directory] $REL_PATH ($REMOVED files removed)"
else
    if [[ "$REMOVED" -gt 0 ]]; then
        echo "   - [Removed File] $REL_PATH"
    else
        echo "   = [Skipped] $REL_PATH (Not in context)"
    fi
fi
EOF

# tools/terminal
cat << 'EOF' > "$TARGET_REPO/tools/terminal"
#!/usr/bin/env bash

PROMPT="$*"
if [[ -z "$PROMPT" ]]; then
    exit 0
fi

if [[ -n "$AGENT_VSCODE_SESSION_DIR" ]]; then
    if [[ -x "$AGENT_VSCODE_DIR/tools/update" ]]; then "$AGENT_VSCODE_DIR/tools/update" -q; fi
fi

TMP_LOGS="$AGENT_VSCODE_DIR/tmp_logs_terminal.txt"
if [[ -n "$AGENT_VSCODE_SESSION_DIR" ]]; then
    "$AGENT_VSCODE_DIR/tools/logs" 100 -q > "$TMP_LOGS" 2>/dev/null
else
    > "$TMP_LOGS"
fi

VSCODE_CONTEXT=""
STATE_FILE="$HOME/.agentvscode/active_editor.json"
if [[ -f "$STATE_FILE" ]] && command -v jq &>/dev/null; then
    F_PATH=$(jq -r '.filePath // empty' "$STATE_FILE")
    if [[ -n "$F_PATH" ]]; then
        F_LINE=$(jq -r '.line' "$STATE_FILE")
        F_CHAR=$(jq -r '.character' "$STATE_FILE")
        F_CONTENT=$(jq -r '.lineContent' "$STATE_FILE")
        F_SEL=$(jq -r '.selectedText' "$STATE_FILE")
        
        VSCODE_CONTEXT="VS CODE EDITOR STATE:
- Active File: $F_PATH
- Cursor Position: Line $F_LINE, Column $F_CHAR
- Current Line Content: \"$F_CONTENT\""
        if [[ -n "$F_SEL" ]]; then
            VSCODE_CONTEXT="${VSCODE_CONTEXT}
- Highlighted Selection: \"$F_SEL\""
        fi
    fi
fi

SYS_PROMPT="You are an automated terminal command assistant. The user typed a natural language prompt instead of a terminal command.
Based on the provided context, output the EXACT, single-line shell command to achieve their request.

Rules:
- Output ONLY the raw command.
- Do NOT use markdown code blocks (no \`\`\`bash).
- Do NOT use backticks.
- Do NOT include any explanations, greetings, or conversational text.
- Do NOT include any trailing newline or return character.
- If multiple commands are needed, chain them on a single line using '&&' or ';'.
- If the request is completely ambiguous or you cannot generate a command, output nothing."

if [[ -z "$AGENT_VSCODE_SESSION_DIR" ]]; then
    SYS_PROMPT="${SYS_PROMPT}

⚠️ NOTE: Currently, there is NO active workspace session context. Suggest a general command based solely on standard shell tools and the active editor file."
fi

PAYLOAD_FILE="$AGENT_VSCODE_DIR/payload_terminal.json"
jq -n --arg pmt "$PROMPT" --arg sys "$SYS_PROMPT" '{"contents":[{"parts":[{"text": ($sys + "

User Question:
" + $pmt)}]}]}' > "$PAYLOAD_FILE"

if [[ -n "$VSCODE_CONTEXT" ]]; then
    jq --arg ctx "$VSCODE_CONTEXT" '.contents[0].parts[0].text = $ctx + "

" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
fi

if [[ -n "$AGENT_VSCODE_SESSION_DIR" ]]; then
    if [[ -s "$AGENT_VSCODE_SESSION_DIR/context.txt" ]]; then 
        jq --rawfile raw "$AGENT_VSCODE_SESSION_DIR/context.txt" '.contents[0].parts[0].text = "Project Context:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
    fi
    if [[ -s "$TMP_LOGS" ]]; then 
        jq --rawfile raw "$TMP_LOGS" '.contents[0].parts[0].text = "Terminal Logs:
" + $raw + "
" + .contents[0].parts[0].text' "$PAYLOAD_FILE" > "${PAYLOAD_FILE}.tmp" && mv "${PAYLOAD_FILE}.tmp" "$PAYLOAD_FILE"
    fi
fi

RESPONSE=$(curl -s -X POST "https://generativelanguage.googleapis.com/v1beta/models/${AGENT_VSCODE_MODEL}:generateContent?key=$GEMINI_API_KEY" \
    -H "Content-Type: application/json" -d @"$PAYLOAD_FILE")

rm -f "$PAYLOAD_FILE" "$TMP_LOGS"

RESULT=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')
CLEAN_RESULT=$(echo "$RESULT" | sed -E 's/^```[a-zA-Z]*//g; s/```$//g; s/`//g' | tr '
' ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
printf "%s" "$CLEAN_RESULT"
EOF

chmod +x "$TARGET_REPO"/tools/*

# ---------------------------------------------------------
# [2/4] Writing manage scripts
# ---------------------------------------------------------
echo '[2/4] Writing decoupled workspace management tools...'

# manage/delete
cat << 'EOF' > "$TARGET_REPO/manage/delete"
#!/usr/bin/env bash
NAME="$1"
if [[ -z "$NAME" ]]; then 
    echo "Usage: agent_vscode delete <name>"
    exit 1
fi
if [[ "$NAME" == ".bindings" ]]; then
    echo "❌ Error: Cannot delete internal system folders."
    exit 1
fi
S_DIR="$AGENT_VSCODE_DIR/sessions/$NAME"
if [[ ! -d "$S_DIR" ]]; then 
    echo "❌ Error: Session '$NAME' does not exist."
    exit 1
fi
rm -rf "$S_DIR"
for binding in "$AGENT_VSCODE_DIR/sessions/.bindings"/*; do
    if [[ -f "$binding" && "$(cat "$binding")" == "$NAME" ]]; then
        rm -f "$binding"
    fi
done
echo "[Global] 🗑️  Session '$NAME' completely deleted."
if [[ "$AGENT_VSCODE_SESSION_NAME" == "$NAME" ]]; then
    echo "[Global] 🛑 Active terminal unbound. Returned to global mode."
fi
EOF

# manage/resume
cat << 'EOF' > "$TARGET_REPO/manage/resume"
#!/usr/bin/env bash
NAME="$1"
if [[ ! -d "$AGENT_VSCODE_DIR/sessions/$NAME" ]]; then echo "❌ Error: Session '$NAME' does not exist."; exit 1; fi

S_DIR="$AGENT_VSCODE_DIR/sessions/$NAME"
CURRENT_TTY=$(tty | sed 's|/|_|g')
echo "$NAME:$$" > "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"

echo "[Session: $NAME] 🔄 Resuming workspace. Dropping into monitored shell..."

export AGENT_VSCODE_SESSION_RESOLVED="1"
export AGENT_VSCODE_SESSION_NAME="$NAME"
export AGENT_VSCODE_SESSION_DIR="$S_DIR"

if [[ "$(uname)" == "Darwin" ]]; then
    script -a -F -q "$S_DIR/logs/terminal_raw.log"
else
    script -a -f -q "$S_DIR/logs/terminal_raw.log"
fi

rm -f "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"
rm -f "$S_DIR/logs/terminal_raw.log"
echo "[Global] 🛑 Session ended. Logs cleared. Terminal unbound."
EOF

# manage/start
cat << 'EOF' > "$TARGET_REPO/manage/start"
#!/usr/bin/env bash
NAME="$1"
if [[ -z "$NAME" ]]; then echo "Usage: agent_vscode start <name>"; exit 1; fi

S_DIR="$AGENT_VSCODE_DIR/sessions/$NAME"
mkdir -p "$S_DIR/logs" "$S_DIR/scripts"
> "$S_DIR/context.txt"
> "$S_DIR/logs/terminal_raw.log"

CURRENT_TTY=$(tty | sed 's|/|_|g')
echo "$NAME:$$" > "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"
echo "[Session: $NAME] Workspace created. Dropping into monitored shell..."

export AGENT_VSCODE_SESSION_RESOLVED="1"
export AGENT_VSCODE_SESSION_NAME="$NAME"
export AGENT_VSCODE_SESSION_DIR="$S_DIR"

if [[ "$(uname)" == "Darwin" ]]; then
    script -F -q "$S_DIR/logs/terminal_raw.log"
else
    script -f -q "$S_DIR/logs/terminal_raw.log"
fi

rm -f "$AGENT_VSCODE_DIR/sessions/.bindings/$CURRENT_TTY"
rm -f "$S_DIR/logs/terminal_raw.log"
echo "[Global] Session ended. Logs cleared. Terminal unbound."
EOF

# manage/stop
cat << 'EOF' > "$TARGET_REPO/manage/stop"
#!/usr/bin/env bash
if [[ -n "$AGENT_VSCODE_SESSION_NAME" ]]; then
    kill -9 $PPID
else
    echo "[Global] You are already in global mode."
fi
EOF

# manage/list
cat << 'EOF' > "$TARGET_REPO/manage/list"
#!/usr/bin/env bash
echo "--- Active VS Code Workspaces ---"
for dir in "$AGENT_VSCODE_DIR/sessions"/*; do
    if [[ -d "$dir" && "$(basename "$dir")" != ".bindings" ]]; then
        S_NAME=$(basename "$dir")
        if [[ "$S_NAME" == "$AGENT_VSCODE_SESSION_NAME" ]]; then echo "  * $S_NAME (Active in this terminal)"
        else echo "    $S_NAME"; fi
    fi
done
EOF

chmod +x "$TARGET_REPO"/manage/*

# ---------------------------------------------------------
# [3/4] Creating separate setup & deploy script
# ---------------------------------------------------------
echo '[3/4] Designing decoupled agent_vscode deploy setup script...'
cat << 'EOF' > "$TARGET_REPO/setup"
#!/usr/bin/env bash
SRC_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]:-$0}")")"
INSTALL_DIR="$HOME/.agent_vscode"
BIN_DIR="$HOME/.local/bin"
RC_FILE="$HOME/.bashrc"
if [[ "$(basename "$SHELL")" == "zsh" ]]; then RC_FILE="$HOME/.zshrc"; fi

echo -e "
⚙️  Deploying isolated agent_vscode package to $INSTALL_DIR..."

# Create clean hierarchy
mkdir -p "$INSTALL_DIR/tools" "$INSTALL_DIR/manage" "$INSTALL_DIR/sessions/.bindings"

# Copy package structures cleanly
cp "$SRC_DIR/agent_vscode" "$INSTALL_DIR/agent_vscode"
cp -r "$SRC_DIR/tools/"* "$INSTALL_DIR/tools/" 2>/dev/null
cp -r "$SRC_DIR/manage/"* "$INSTALL_DIR/manage/" 2>/dev/null

chmod +x "$INSTALL_DIR/agent_vscode"
chmod +x "$INSTALL_DIR"/tools/*
chmod +x "$INSTALL_DIR"/manage/*

# Bind Symlink
mkdir -p "$BIN_DIR"
ln -sf "$INSTALL_DIR/agent_vscode" "$BIN_DIR/agent_vscode"
echo "   ✔ Global decoupled symlink established ($BIN_DIR/agent_vscode -> $INSTALL_DIR/agent_vscode)"

# Secure path inclusion
if ! grep -q "$BIN_DIR" "$RC_FILE" 2>/dev/null; then
    echo -e "
export PATH=\"\$HOME/.local/bin:\$PATH\"" >> "$RC_FILE"
    echo "   ✔ PATH updated in $(basename "$RC_FILE")"
fi

# Inject Terminal Command Router Integration safely
if [[ "$RC_FILE" == *".zshrc" ]]; then
    # Clean previous blocks safely
    if grep -q "command_not_found_handler" "$RC_FILE"; then
        cp "$RC_FILE" "${RC_FILE}.bak"
        perl -0777 -pe 's/# --- AGENT VSCODE COMMAND ROUTER INTEGRATION ---.*?# --- END AGENT VSCODE INTEGRATION ---//gs' "${RC_FILE}.bak" > "$RC_FILE"
        perl -i -ne 'print unless /command_not_found_handler/ || /agent suggest/ || /agent terminal/ || /agent_vscode terminal/' "$RC_FILE"
    fi

    cat << 'OUT_EOF' >> "$RC_FILE"

# --- AGENT VSCODE COMMAND ROUTER INTEGRATION ---
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
    command_not_found_handler() {
        if command -v agent_vscode &>/dev/null; then
            if [[ -z "$AGENT_VSCODE_SESSION_NAME" ]]; then
                echo "ℹ️  No active agent_vscode session. Using general LLM suggestion..." >&2
            fi

            # Contact isolated VS Code agent for command suggestion
            local suggestion
            suggestion=$(agent_vscode terminal "$@")

            # If agent suggests nothing, behave standardly
            if [[ -z "$suggestion" ]]; then
                echo "zsh: command not found: $1" >&2
                return 127
            fi

            # Print suggested command and stage it in the terminal input buffer
            echo "💡 Suggested Command: $suggestion"
            print -z "$suggestion"
            return 0
        else
            echo "zsh: command not found: $1" >&2
            return 127
        fi
    }
fi
# --- END AGENT VSCODE INTEGRATION ---
OUT_EOF
    echo "   ✔ Command Router integration updated inside $RC_FILE."
fi

echo -e "
✅ agent_vscode deployment complete!"
echo -e "-------------------------------------------------------"
echo -e " 🚀 DEVELOPER WORKFLOW TIPS"
echo -e "-------------------------------------------------------"
echo -e " - Write & edit your code safely in: $SRC_DIR"
echo -e " - Execute 'bash setup' inside your repository to deploy changes."
echo -e " - Run 'agent_vscode help' to test."
echo -e "-------------------------------------------------------
"
EOF

chmod +x "$TARGET_REPO/setup"

# Wipe local clashing files from the agentvscode source folder to guarantee decoupling is 100% complete
rm -f "$TARGET_REPO/agent"

# ---------------------------------------------------------
# [4/4] Executing bash setup locally inside agentvscode
# ---------------------------------------------------------
echo '[4/4] Running setup locally in your workspace to deploy to ~/.agent_vscode...'
bash "$TARGET_REPO/setup"
